{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ejazati",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html"]
  }
}
